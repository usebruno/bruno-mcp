{
  "name": "@usebruno/mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Model Context Protocol server for Bruno collections — lets AI clients discover and execute Bruno requests reusing Bruno's runtime, auth, and environments.",
  "type": "module",
  "bin": {
    "bruno-mcp": "./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/usebruno/bruno-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usebruno/bruno-mcp.git"
  },
  "keywords": [
    "bruno",
    "mcp",
    "model-context-protocol",
    "ai",
    "api-testing",
    "claude",
    "cursor"
  ],
  "files": [
    "dist",
    "README.md",
    "license.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@usebruno/cli": "4.0.0",
    "@usebruno/filestore": "0.11.0",
    "js-yaml": "^4.1.0",
    "yaml": "^2.9.1",
    "yargs": "^17.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/yargs": "^17.0.33",
    "jest": "^30.5.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
